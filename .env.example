# Copy to .env for local runs. Nothing here is a real credential.
SCR_DATABASE_URL=postgresql:///scr
SCR_TEST_DATABASE_URL=postgresql:///scr_test
# key:role pairs, keys at least 16 characters; roles viewer, reviewer, admin
SCR_API_KEYS=change-me-viewer-0001:viewer,change-me-reviewer-01:reviewer,change-me-admin-00001:admin
# SCR_AUTH=off              # local development only: no keys needed
# SCR_GCS_BUCKET=           # store raw audio in GCS instead of data/store
# SCR_RELEASES_BUCKET=      # publish releases to GCS
# SCR_MODEL_THREADS=1
